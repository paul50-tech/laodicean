# ==============================================================================
# Laodicean (laodicean.online) - Environment Variables
# ==============================================================================

# Supabase Credentials
# Copy from: Supabase Dashboard -> Project Settings -> API
# 1. Project URL (e.g., https://xyzcompany.supabase.co)
# 2. Project API anon key (public)

# For Vite (used in local development and live preview):
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# For Next.js (if deploying with Next.js App Router on Vercel):
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Public Canonical Site URL
VITE_SITE_URL="https://laodicean.online"
NEXT_PUBLIC_SITE_URL="https://laodicean.online"
